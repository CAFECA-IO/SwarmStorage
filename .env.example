# Info: (20261122 - Luphia)
# DropHere 環境變數範本：複製為 .env.local (本機開發) 或部署環境的 env_file 後修改
# 註明「必填」的項目在正式環境一定要設定；其餘留空或刪除即使用預設值
# 含私鑰與金鑰的檔案不要 commit (.gitignore 已排除 .env*，只保留這份範本)

# ---------------------------------------------------------------
# 基本
# ---------------------------------------------------------------

# 必填 (正式環境)：網站網址 (改成你的網域)，多個以逗號分隔
# 未設定時 CAFECA 只能從 localhost 登入；手機錢包付款連結也使用這個網址
PUBLIC_ORIGIN=https://drophere.io

# IPFS 節點 API (預設 http://127.0.0.1:5001)；Docker / Caloud 上填服務名稱，例如 http://ipfs_bootstrap:5001
IPFS_API_URL=http://127.0.0.1:5001

# 資料目錄：留空使用預設值 (專案目錄下的 ./room 與 ./.drophere)
# 執行程式的使用者必須能在這兩個目錄寫入；改路徑時記得把既有資料搬過去，否則舊房間會看不到
#
# 房間資料目錄 (預設 ./room)
#   直接在主機上執行 (pm2 等)：通常留空即可；要放到其他位置時先建立並設定擁有者，例如
#     sudo mkdir -p /var/lib/drophere/room && sudo chown -R $(whoami) /var/lib/drophere
#     ROOM_DATA_DIR=/var/lib/drophere/room
#   Docker / Caloud：設定為容器內的路徑，並在該路徑掛持久化 volume，例如
#     ROOM_DATA_DIR=/app/room
ROOM_DATA_DIR=
#
# 伺服器資料目錄 (預設 ./.drophere)：登入金鑰與付款紀錄，需持久化 (容器部署時同樣要掛 volume)
#   主機範例：DROPHERE_DATA_DIR=/var/lib/drophere/data
#   Docker 範例：DROPHERE_DATA_DIR=/app/.drophere
DROPHERE_DATA_DIR=

# 登入 cookie 簽章金鑰 (至少 32 字元)；留空時自動產生並存於 DROPHERE_DATA_DIR/session.key
# 更換後所有人都會被登出
SESSION_SECRET=

# ---------------------------------------------------------------
# CAFECA 登入
# ---------------------------------------------------------------

# CAFECA 錢包網址 (預設 https://cafeca.io)；填 off 關閉登入
CAFECA_WALLET=https://cafeca.io

# 選填：自架的 Boltchain RPC (預設使用錢包設定中的公開 RPC)
CAFECA_RPC_URL=

# ---------------------------------------------------------------
# 付款 (Solana 上的 USDC / USDT)
# PAY_TREASURY 與 PAY_FEE_PAYER_SECRET 都設定才會開啟付款功能
# ---------------------------------------------------------------

# 必填 (開啟付款時)：Solana RPC
# 測試：https://api.devnet.solana.com (並設定下方 PAY_USDC_MINT)
# 正式：使用 RPC 服務商 (Helius、Alchemy、dRPC 等)；官方公開節點有限流，不適合正式環境
SOLANA_RPC_URL=https://api.devnet.solana.com

# 平台收款地址 (延長房間的款項、付費房 10% 抽成)
PAY_TREASURY=

# 代付網路手續費的錢包私鑰：JSON 陣列 (solana-keygen 格式) 或 base58
# 只放少量 SOL；這把私鑰只用來付手續費，不要放其他資產
PAY_FEE_PAYER_SECRET=

# 付費房賣家需要的 CAFECA 實名等級 (預設 2)
PAY_SELLER_KYC=2

# 免費房間容量上限 (GB，預設 10)
FREE_ROOM_GB=10

# 選填：幣種地址，只在 devnet 測試時覆寫 (預設為主網 USDC / USDT)
# PAY_USDC_MINT=
# PAY_USDT_MINT=

# ---------------------------------------------------------------
# 視訊通話 (LiveKit)：LIVEKIT_URL、LIVEKIT_API_KEY、LIVEKIT_API_SECRET 都設定才會開啟
# LiveKit 伺服器本身的設定見 deploy/livekit/README.md
# ---------------------------------------------------------------

# 伺服器呼叫 LiveKit API 的網址
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 瀏覽器連線用的網址 (預設同 LIVEKIT_URL)；伺服器內外網址不同時才需要設定
LIVEKIT_PUBLIC_URL=

# LiveKit 房間名稱前綴 (預設 drophere-)
LIVEKIT_ROOM_PREFIX=drophere-

# 每間房的通話人數上限 (預設 50，最多 500)
CALL_MAX_PARTICIPANTS=50

# 驗證 LiveKit webhook (人數變更通知) 的金鑰；留空時使用 LIVEKIT_API_KEY / SECRET
# LiveKit 只能設定一組 webhook 金鑰，與其他服務共用 LiveKit 時才需要另外設定
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=

# ---------------------------------------------------------------
# 文件與 PDF
# ---------------------------------------------------------------

# 選填：Chrome / Chromium 路徑 (預設自動尋找)；找不到時改用瀏覽器列印
DOCS_PDF_CHROME=

# PDF 壓縮與分割可處理的大小上限 (MB，預設 600)
PDF_FIT_MAX_MB=600
