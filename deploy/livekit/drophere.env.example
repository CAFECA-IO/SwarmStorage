# Info: (20261106 - Luphia) DropHere 的通話設定，寫入專案根目錄的 .env.local (next start 會自動載入)
LIVEKIT_URL=wss://livekit.cafeca.io
LIVEKIT_API_KEY=drophere
LIVEKIT_API_SECRET=<DROPHERE_API_SECRET>
# 選填：LiveKit 在內網時，伺服器呼叫 API 用內網位址，瀏覽器用公開位址
# LIVEKIT_URL=http://10.0.0.5:7880
# LIVEKIT_PUBLIC_URL=wss://livekit.cafeca.io
# 選填：與 livekit.yaml 的 webhook 金鑰相同
LIVEKIT_WEBHOOK_API_KEY=webhook
LIVEKIT_WEBHOOK_API_SECRET=<WEBHOOK_SECRET>
# 選填：房間名稱前綴與人數上限 (預設 drophere-、50)
# LIVEKIT_ROOM_PREFIX=drophere-
# CALL_MAX_PARTICIPANTS=50
