# Info: (20261106 - Luphia)
# 共用 LiveKit SFU 設定範例 (DropHere 房間通話 + Hills M4 會議)
# 複製為 livekit.yaml 後填入實際金鑰；不要提交到 repo

port: 7880                 # 信令 (WebSocket)，由反向代理提供 wss://
log_level: info

rtc:
  tcp_port: 7881           # UDP 被擋時的 TCP 備援
  udp_port: 7882           # 所有媒體共用單一 UDP 埠，防火牆只需開這一個
  use_external_ip: true    # 以 STUN 取得公網 IP 放進 ICE candidate

# Info: (20261106 - Luphia) 公司網路擋 UDP / 非 443 埠時，改走 TURN over TLS
turn:
  enabled: true
  domain: turn.cafeca.io
  tls_port: 5349
  udp_port: 3478
  cert_file: /certs/turn.cafeca.io.crt
  key_file: /certs/turn.cafeca.io.key

# Info: (20261106 - Luphia) 各服務使用自己的金鑰，可個別撤換；secret 至少 32 字元
keys:
  drophere: <DROPHERE_API_SECRET>
  hills: <HILLS_API_SECRET>
  webhook: <WEBHOOK_SECRET>

# Info: (20261106 - Luphia) LiveKit 只能設定一組 webhook 簽章金鑰；兩個服務都持有 webhook secret，
# 各自依房間名稱前綴 (drophere- / hills-) 略過不屬於自己的事件
webhook:
  api_key: webhook
  urls:
    - https://drophere.io/api/v1/livekit/webhook
    # - https://hills-call.cafeca.io/v1/livekit/webhook   # Hills M4 hills-call

room:
  empty_timeout: 300
  max_participants: 50     # 預設上限；DropHere 建立房間時也會指定

# prometheus:
#   port: 6789             # 監控 (CPU、封包、流量)，只開放給內網
