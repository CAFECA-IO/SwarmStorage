# Info: (20261106 - Luphia) 複製為 .env 後修改；API key / secret 與憑證會自動產生，不需填寫

# 信令網域 (DNS A 記錄指向本機公網 IP)
LIVEKIT_DOMAIN=livekit.cafeca.io
# TURN/TLS 網域 (同一台主機)；留空則不啟用 TURN
TURN_DOMAIN=turn.cafeca.io
# Let's Encrypt 到期通知信箱
ACME_EMAIL=

# wss 信令的埠；預設 443 (客戶端連線 wss://LIVEKIT_DOMAIN)
# 443 已被其他服務使用時可改用其他埠，但只允許 443 對外連線的網路將無法加入通話
LIVEKIT_PORT=443
# Let's Encrypt HTTP-01 驗證固定從外部連到 80 埠；80 已被其他服務使用時，
# 改成其他埠並由該服務把 /.well-known/acme-challenge/ 轉送到 127.0.0.1:ACME_HTTP_PORT
ACME_HTTP_PORT=80

# 人數變更通知 (留空則不送 webhook)
DROPHERE_WEBHOOK_URL=https://drophere.io/api/v1/livekit/webhook
HILLS_WEBHOOK_URL=

# 每間房的人數上限
MAX_PARTICIPANTS=50

# TURN 憑證續期後，在 UTC 幾點 (0–23) 重新啟動 LiveKit 載入新憑證；20 = 台灣凌晨 4 點
CERT_RELOAD_HOUR_UTC=20

# 選填：不使用 STUN 偵測公網 IP 時，直接指定
# NODE_IP=203.0.113.10
# 選填：監控 (只開放給內網)
# PROMETHEUS_PORT=6789
